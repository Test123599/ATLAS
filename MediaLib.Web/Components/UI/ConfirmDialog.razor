<div class="modal-backdrop" role="presentation" @onclick="Annuler">
    <div class="modal-card" role="dialog" aria-modal="true" aria-label="@Titre" @onclick:stopPropagation="true">
        <p class="eyebrow">Confirmation</p>
        <h2>@Titre</h2>
        <p class="modal-message">@Message</p>
        <div class="modal-actions">
            <button class="btn btn-quiet" type="button" @onclick="Annuler">Annuler</button>
            <button class="btn @(Danger ? "btn-danger" : "btn-solid")" type="button" @onclick="Confirmer">@ConfirmLabel</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Titre { get; set; } = "Confirmer l'action";
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmLabel { get; set; } = "Confirmer";
    [Parameter] public bool Danger { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Confirmer() => await OnConfirm.InvokeAsync();
    private async Task Annuler() => await OnCancel.InvokeAsync();
}
